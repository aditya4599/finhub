# Copy to .env (which is git-ignored) and fill in. Never commit real keys.

# Finnhub API key for scripts/live_news_search.py (free: https://finnhub.io/register)
FINNHUB_API_KEY=

# Hugging Face token, only needed if the news corpus requires authentication
# (alternatively run `huggingface-cli login`).
HF_TOKEN=

# Optional: override the project root used to resolve relative paths.
# FINSEARCH_HOME=/path/to/FinSearch
